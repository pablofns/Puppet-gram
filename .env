# Configuración del Bot de Instagram

# Directorio donde se guardarán las cookies y sesión del navegador para evitar loguearse cada vez
USER_DATA_DIR=./session

# Indica si se ejecuta en segundo plano (headless = true) o visible (headless = false)
# La primera vez DEBE ser false para que puedas iniciar sesión manualmente.
HEADLESS=false

# Opcional: Credenciales si quieres que intente escribir tu usuario/contraseña automáticamente.
# NOTA: Incluso con esto, es posible que Instagram te pida 2FA o confirmación por correo.
INSTAGRAM_USERNAME=tu_usuario_de_instagram
INSTAGRAM_PASSWORD=tu_contraseña_de_instagram
